{
  "name": "orbit-yt-dlp-gui",
  "version": "0.2.1",
  "description": "Orbit – YouTube Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-store": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.orbit.ytdownloader",
    "productName": "Orbit – YT Downloader",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "files": [
      "**/*",
      "!bin/win/*",
      "!dist/*"
    ],
    "extraResources": [
      {
        "from": "bin/win",
        "to": "bin",
        "filter": [
          "*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "orbit-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}