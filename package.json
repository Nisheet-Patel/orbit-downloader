{
  "name": "orbit-downloader",
  "version": "0.3.1",
  "description": "Orbit Downloader – A modern cross-platform media downloader supporting YouTube, Spotify, and other platforms.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && node scripts/verify-build.js",
    "build:renderer": "cd renderer && npm run build",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.orbit.downloader",
    "productName": "Orbit Downloader",
    "publish": [
      {
        "provider": "github",
        "owner": "Nisheet-Patel",
        "repo": "orbit-downloader"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/dist/**/*",
      "orbit-logo.svg",
      "orbit-logo.ico",
      "licenses/**/*",
      "!bin/win/**/*",
      "!renderer/node_modules/**/*",
      "!renderer/src/**/*",
      "!renderer/**/*.config.*",
      "!renderer/*.json",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/win",
        "to": "bin",
        "filter": [
          "*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "orbit-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
